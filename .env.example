# ─── Meta / Instagram Graph API ───────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Long-lived Page Access Token (generated in Meta Business Suite or via OAuth flow)
META_ACCESS_TOKEN=your_long_lived_page_access_token
# Arbitrary secret you choose; must match what you enter in Meta webhook settings
META_VERIFY_TOKEN=your_custom_webhook_verify_token
# Instagram Business Account ID (numeric, find it in Meta Business Suite)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ─── Grok / xAI API ───────────────────────────────────────────────────────────
GROK_API_KEY=xai-your_grok_api_key
GROK_MODEL=grok-3

# ─── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Secret for protecting the admin dashboard API – use a long random string
ADMIN_SECRET=change_me_to_a_long_random_string

# ─── Polling fallback (use if Meta webhook cannot reach your server) ───────────
ENABLE_POLLING=false
POLL_INTERVAL_SECONDS=30

# ─── Safety / rate limiting ───────────────────────────────────────────────────
# Max AI replies per user within a 1-hour window
MAX_REPLIES_PER_USER_PER_HOUR=10
